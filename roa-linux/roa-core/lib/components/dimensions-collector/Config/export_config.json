{
  "rosbag": {
    "enabled": true,
    "retention_days": 7,
    "topics": [
      "/dimc/robot/+/pose",
      "/dimc/robot/+/velocity",
      "/dimc/distances"
    ]
  },
  "json": {
    "enabled": true,
    "retention_days": 30,
    "include_task_summary": true
  },
  "csv": {
    "enabled": false,
    "fields": ["timestamp", "robot_id", "x", "y", "z", "vx", "vy", "vz"]
  }
}
