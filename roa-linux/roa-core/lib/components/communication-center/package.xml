<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>communication_center</name>
  <version>0.1.0</version>
  <description>Communication Center (COMC) - Multi-robot coordination and communication for ROA</description>
  
  <maintainer email="support@roa-robotics.org">ROA Team</maintainer>
  <license>MIT</license>
  
  <url type="website">https://github.com/Omar-Galal-AB/ROA</url>
  <url type="bugtracker">https://github.com/Omar-Galal-AB/ROA/issues</url>
  <url type="repository">https://github.com/Omar-Galal-AB/ROA</url>
  
  <author>ROA Development Team</author>
  
  <!-- Build dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  
  <!-- Runtime dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  
  <!-- Message generation -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  
  <!-- Testing dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
